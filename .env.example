# 星渡 (XingDu) — LLM API Gateway

## 基础
XINGDU_HOST=0.0.0.0
XINGDU_PORT=9999
XINGDU_DUMP_DIR=./dumps
XINGDU_MAX_MESSAGES=100
XINGDU_AUTO_RETRY=1
XINGDU_AUTO_RETRY_MAX=3

## 后端
XINGDU_BACKEND_NAME=dashscope
XINGDU_BACKEND_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic/v1/messages
XINGDU_BACKEND_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XINGDU_BACKEND_MODEL=qwen3.6-plus

## 工具压缩
XINGDU_TOOL_COMPRESSION=0
XINGDU_TOOL_COMPRESSION_MIN=1000

## Prompt Cache
XINGDU_PROMPT_CACHE=0

## 响应缓存
XINGDU_RESP_CACHE=1
XINGDU_RESP_CACHE_TTL=21600
XINGDU_REDIS_URL=
## 注意: 内存缓存 max_entries 硬编码为 500 条

## 星枢 RAG
XINGDU_STARHUB_ENABLED=0
XINGDU_STARHUB_URL=http://localhost:26670
XINGDU_STARHUB_LIMIT=5
XINGDU_STARHUB_TIMEOUT=10

## 成本路由
XINGDU_COST_ROUTING=0
XINGDU_CHEAP_MODEL=
XINGDU_EXPENSIVE_MODEL=

## Token 预算
XINGDU_TOKEN_BUDGET=0

## Fallback
XINGDU_FALLBACK_ENABLED=0
XINGDU_FALLBACK_CHAIN=
XINGDU_FALLBACK_TIMEOUT=30

## 熔断器
XINGDU_CIRCUIT_BREAKER_THRESHOLD=5
XINGDU_CIRCUIT_BREAKER_RECOVERY=60

## 安全
XINGDU_AUTH_ENABLED=0
XINGDU_API_KEYS=
XINGDU_IP_WHITELIST=
XINGDU_RATE_LIMIT=0

## 指标
XINGDU_METRICS_ENABLED=0
XINGDU_METRICS_SQLITE_PATH=./metrics.db

## 审计
XINGDU_AUDIT_LOG=0
XINGDU_AUDIT_LOG_PATH=./audit.log

## Dashboard
XINGDU_DASHBOARD_ENABLED=0
XINGDU_DASHBOARD_PORT=9998
